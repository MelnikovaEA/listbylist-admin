{
  "name": "checklist-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "assets:generate": "tsx scripts/generate-preview-variants.ts",
    "s3:test": "node --conditions=react-server --import tsx scripts/test-s3-connection.ts",
    "test:files": "node --conditions=react-server --import tsx --test src/lib/storage/objectStorage.test.ts src/features/categories/services/resolveChecklistCategory.test.ts src/features/checklists/files/validation.test.ts src/features/checklists/files/bundle.test.ts src/features/checklists/files/links.test.ts src/features/checklists/files/prefix.test.ts src/features/checklists/files/url.test.ts src/features/checklists/form/validation.test.ts src/features/checklists/services/saveChecklistFiles.test.ts src/features/checklists/services/saveChecklist.test.ts src/features/checklists/services/deleteChecklist.test.ts src/features/checklists/ui/ChecklistForm/CategoryCombobox.test.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
